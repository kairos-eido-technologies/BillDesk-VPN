<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Main Container -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Thin Action Bar (Hidden for full-screen native mobile experience) -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/white"
            android:paddingHorizontal="12dp"
            android:elevation="2dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/app_logo"
                android:contentDescription="Store Logo" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="MSS Ponkumar Store"
                android:textColor="@color/brand_navy"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tvServerPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ONLINE"
                android:textColor="#16A34A"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="#DCFCE7"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginEnd="8dp" />

            <ImageButton
                android:id="@+id/btnServerSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_manage"
                android:tint="@color/brand_navy"
                android:contentDescription="Server Config" />
        </LinearLayout>

        <!-- Loading Progress Bar -->
        <ProgressBar
            android:id="@+id/pageProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_alignParentTop="true"
            android:progressTint="@color/brand_red"
            android:visibility="gone" />

        <!-- Swipe Refresh Layout containing WebView (Full Screen Phone Ratio) -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Server Connection Setup Overlay -->
        <ScrollView
            android:id="@+id/serverSetupLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="@color/bg_light"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@drawable/app_logo"
                    android:contentDescription="MSS Ponkumar Store" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MSS PONKUMAR STORE"
                    android:textColor="@color/brand_navy"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WHOLESALE SHOP · MOBILE POS TERMINAL"
                    android:textColor="@color/brand_red"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="4dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Connect to Desktop Server"
                            android:textColor="@color/text_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Enter the IP address of the Desktop computer running MSS Ponkumar Store (shown on Desktop in 'Server Host &amp; VPN')."
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:layout_marginTop="6dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilServerUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="Desktop Server URL / IP:Port"
                            app:boxStrokeColor="@color/brand_navy"
                            app:hintTextColor="@color/brand_navy"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etServerUrl"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="http://192.168.1.100:3000"
                                android:inputType="textUri"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/tvConnectionStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/brand_red"
                            android:textSize="12sp"
                            android:layout_marginTop="10dp"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/btnConnect"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="Connect &amp; Start Billing"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/brand_navy"
                            android:textColor="@color/white"
                            android:layout_marginTop="16dp"
                            app:cornerRadius="10dp" />

                        <Button
                            android:id="@+id/btnCancelConnect"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="Cancel / Return to App"
                            android:textSize="13sp"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:textColor="@color/text_muted"
                            android:layout_marginTop="6dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tip: Keep phone &amp; desktop connected to the same Wi-Fi router for fast offline synchronization."
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginTop="20dp" />
            </LinearLayout>
        </ScrollView>

    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

